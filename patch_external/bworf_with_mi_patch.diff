+    print("Using n_tries=5 to verify parameter wiring")
+    print("="*90)
+    
+    bworf_debug = ObliqueRandomForestMulti(
+        n_estimators=1,  # Just one tree for testing
+        max_depth=3,
+        min_samples_split=10,
+        min_samples_leaf=3,
+        l1_strength=1.0,
+        random_state=42,
+        debug_trace=True,
+        debug_max_nodes=3,
+        weighted_bootstrap=True,
+        n_tries=5  # Test n_tries parameter
+    )
+    
+    bworf_debug.fit(X_test, y_test)
+    
+    # Make predictions to verify the tree works
