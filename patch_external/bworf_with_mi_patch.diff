+def test_weighted_leaf_consistency():
+    """
+    Unit test to verify leaf probabilities and terminal predictions remain
+    consistent with weighted node training statistics.
+    """
+    print("=" * 60)
+    print("TEST: Weighted Leaf Consistency")
+    print("=" * 60)
+
+    X = np.array([[0.0], [1.0], [2.0], [3.0], [4.0]])
+    y = np.array([0, 0, 0, 0, 1])
+
+    tree = ObliqueDecisionTreeMulti(max_depth=0, min_samples_split=10, min_samples_leaf=1, random_state=42)
+    tree.fit(X, y)
+
+    leaf = tree.tree
+    raw_predicted_class = int(np.argmax(leaf['class_counts']))
+    weighted_predicted_class = int(leaf['predicted_class'])
+    weighted_probs = np.asarray(leaf['class_probabilities'], dtype=float)
+
+    print(f"Raw class counts: {leaf['class_counts']}")
+    print(f"Weighted class probabilities: {np.round(weighted_probs, 4)}")
+    print(f"Raw-majority class: {raw_predicted_class}")
+    print(f"Weighted predicted class: {weighted_predicted_class}")
+
+    probs = tree.predict_proba(X[:1])[0]
+    print(f"predict_proba(first sample): {np.round(probs, 4)}")
+
+    passed = (
+        raw_predicted_class == 0
+        and weighted_predicted_class == 0
+        and np.allclose(weighted_probs.sum(), 1.0)
+        and np.allclose(probs, weighted_probs)
+    )
+
+    if passed:
+        print("PASS: leaf probabilities follow weighted statistics and hard labels use a stable raw-count tie-break.")
+    else:
+        print("FAIL: weighted leaf behavior is inconsistent.")
+
+    print("=" * 60)
+    return passed
+
