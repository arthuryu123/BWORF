+def generate_rotated_dataset():
+    """
+    Generate synthetic dataset with oblique decision boundaries for DILI classification.
+    
+    Returns:
+        X_rotated: Rotated feature matrix (1200 x 10)
+        y: Target labels (6 classes representing DILI risk categories)
+    """
+    print("Generating base synthetic dataset...")
+    
+    # Generate base dataset with specified parameters
+    X, y = make_classification(
+        n_samples=1200, 
+        n_features=10, 
+        n_classes=6,
+        n_informative=8,  # Need enough informative features for 6 classes
+        n_redundant=1,
+        n_clusters_per_class=1,
+        class_sep=1.5,
+        flip_y=0.01,
+        random_state=42
+    )
+    
+    print("Applying random rotation using QR decomposition...")
+    
+    # Apply random rotation using QR decomposition to introduce oblique boundaries
+    np.random.seed(42)
+    random_matrix = np.random.randn(10, 10)
+    Q, R = np.linalg.qr(random_matrix)
+    X_rotated = X @ Q
+    
+    return X_rotated, y
