+    def _weighted_class_totals(self, y, weights=None, n_classes=None):
+        """
+        Compute per-class totals using either raw counts or explicit sample weights.
+
+        Args:
+            y: Target labels
+            weights: Optional sample weights aligned to ``y``
+            n_classes: Optional total number of classes
+
+        Returns:
+            totals: Array of length ``n_classes`` with class totals
+        """
+        if n_classes is None:
+            n_classes = self.n_classes_ if self.n_classes_ is not None else len(np.unique(y))
+
+        if len(y) == 0:
+            return np.zeros(n_classes, dtype=float)
+
+        if weights is None:
+            return np.bincount(y, minlength=n_classes).astype(float)
+
+        weights = np.asarray(weights, dtype=float)
+        totals = np.zeros(n_classes, dtype=float)
+        for cls in range(n_classes):
+            mask = (y == cls)
+            if np.any(mask):
+                totals[cls] = weights[mask].sum()
+        return totals
+    
+    def _gini_impurity(self, y, weights=None):
+        """
+        Calculate Gini impurity for multiclass classification.
+        
+        Args:
+            y: Target labels
+            weights: Optional sample weights (if None, uniform weights)
+            
+        Returns:
+            Gini impurity score
+        """
+        if len(y) == 0:
+            return 0
+        
+        n_classes = self.n_classes_ if self.n_classes_ is not None else len(np.unique(y))
+
+        class_totals = self._weighted_class_totals(y, weights=weights, n_classes=n_classes)
+        total_mass = class_totals.sum()
+        if total_mass <= 0:
+            return 0.0
+
+        probabilities = class_totals / total_mass
+
+        # Gini = 1 - sum(p_i^2)
+        return 1 - np.sum(probabilities ** 2)
