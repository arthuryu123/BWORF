+    def __init__(self, max_depth=5, min_samples_split=10, min_samples_leaf=5, l1_strength=1.0, 
+                 random_state=None, debug_trace=False, debug_max_nodes=3, n_tries=10):
+        """
+        Initialize oblique decision tree with L1-regularized splits.
+        
+        Args:
+            max_depth: Maximum tree depth
+            min_samples_split: Minimum samples required to split
+            min_samples_leaf: Minimum samples in leaf nodes
+            l1_strength: L1 regularization strength (higher = more sparse)
+            random_state: Random seed for reproducibility
+            debug_trace: Enable debug trace mode for verification
+            debug_max_nodes: Maximum number of nodes to trace in debug mode
+            n_tries: Number of random binary split attempts per node (default=10)
+        """
+        self.max_depth = max_depth
+        self.min_samples_split = min_samples_split
+        self.min_samples_leaf = min_samples_leaf
+        self.l1_strength = l1_strength
+        self.random_state = random_state
+        self.debug_trace = debug_trace
+        self.debug_max_nodes = debug_max_nodes
+        self.n_tries = n_tries
+        self.tree = None
+        self.n_classes_ = None  # Will be set during fit
+        self._debug_node_counter = 0  # Counter for debug trace
+        self._l1_warning_issued = False  # Track if we've warned about invalid l1_strength
+        
+    def compute_node_weights(self, y, class_weight_mode="balanced", normalize=True):
+        """
+        Compute explicit per-sample weights ω_i^(t) for a node.
+        
+        Args:
+            y: Target labels for samples in this node
+            class_weight_mode: "balanced" for inverse frequency weighting
+            normalize: If True, normalize weights to sum=1 (for Gini); 
+                      If False, return raw weights (for LogisticRegression)
+            
+        Returns:
+            weights: Raw or normalized sample weights
+        """
+        n_samples = len(y)
+        if n_samples == 0:
+            return np.array([])
+        
+        unique_classes, class_counts = np.unique(y, return_counts=True)
+        n_classes = len(unique_classes)
+        
+        # Compute class weights: w_class[k] = n_samples / (n_classes * count_k)
+        class_weights_dict = {}
+        for cls, count in zip(unique_classes, class_counts):
+            if class_weight_mode == "balanced":
+                class_weights_dict[cls] = n_samples / (n_classes * count)
+            else:
+                class_weights_dict[cls] = 1.0  # Uniform weights
+        
+        # Assign weights to samples based on their class
+        weights = np.array([class_weights_dict[label] for label in y])
+        
+        # Normalize to sum to 1.0 if requested
+        if normalize:
+            weights = weights / weights.sum()
+            
+            # Verification in debug mode
+            if self.debug_trace and abs(weights.sum() - 1.0) > 1e-8:
+                raise ValueError(f"Weights do not sum to 1.0: {weights.sum()}")
+        
+        return weights
