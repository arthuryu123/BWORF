+def test_debug_trace(test_weighted_bootstrap=False):
+    """
+    Lightweight test to verify debug trace mode and CART-style threshold optimization.
+    
+    This test creates a small random dataset and trains a single BWORF tree with debug_trace=True
+    to verify that:
+    1. Explicit node weights ω_i^(t) are computed (raw vs normalized)
+    2. CART-style threshold optimization is performed (not just using -intercept)
+    3. Debug output is generated for the first few nodes
+    4. n_tries parameter is correctly wired and used
+    5. (Optional) Weighted bootstrap sampling is working correctly
+    
+    Args:
+        test_weighted_bootstrap: If True, also test weighted bootstrap mode
+    """
+    print("="*90)
+    print("DEBUG TRACE TEST FOR BWORF")
+    print("="*90)
+    print("\nTesting explicit node weights and CART-style threshold optimization...")
+    
+    # Create a small random dataset
+    np.random.seed(42)
+    X_test = np.random.randn(100, 5)
+    y_test = np.random.randint(0, 3, size=100)  # 3 classes
