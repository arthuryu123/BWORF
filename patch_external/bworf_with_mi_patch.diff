+    )
+    disp_rf.plot(ax=axes[1], cmap='Greens', values_format='d')
+    axes[1].set_title(f'Standard Random Forest (Original Features)\nAccuracy: {acc_rf:.4f} | Macro F1: {f1_rf:.4f}')
+    
+    plt.tight_layout()
+    plt.show()
+    
+    # Generate ROC curves for multiclass classification
+    print("\nGenerating ROC curves for each class...")
+    
+    # Create figure for ROC curves
+    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 6))
+    
+    class_names = [f'DILI-{i}' for i in range(6)]
+    colors = ['#e41a1c', '#377eb8', '#4daf4a', '#984ea3', '#ff7f00', '#ffff33']
