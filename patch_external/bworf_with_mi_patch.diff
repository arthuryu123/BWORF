+class BWORFClassifier(ObliqueRandomForestMulti):
+    """
+    BWORF (Bootstrap Weighted Oblique Random Forest) Classifier.
+    
+    This is the BWORF model used in the v3 simulation study. It is a thin wrapper
+    around ObliqueRandomForestMulti to provide a consistent import interface:
+    
+        from models.bworf_with_mi import BWORFClassifier
+    
+    Inherits all functionality from ObliqueRandomForestMulti including:
+    - L1-regularized oblique splits
+    - Weighted bootstrap sampling enabled by default (can be disabled explicitly)
+    - Multiclass classification support
+    - fit(X, y), predict(X), predict_proba(X) methods
+    """
+    
+    def __init__(
+        self,
+        n_estimators=100,
+        max_depth=5,
+        min_samples_split=10,
+        min_samples_leaf=5,
+        l1_strength=1.0,
+        random_state=None,
+        debug_trace=False,
+        debug_max_nodes=3,
+        weighted_bootstrap=True,
+        bootstrap_weight_mode="balanced",
+        bootstrap_temperature=1.0,
+        n_tries=10,
+    ):
+        """
+        Initialize BWORFClassifier.
+        
+        Parameters match ObliqueRandomForestMulti exactly. BWORFClassifier defaults to weighted_bootstrap=True and n_tries=10 so the wrapper reflects the intended BWORF configuration.
+        """
+        super().__init__(
+            n_estimators=n_estimators,
+            max_depth=max_depth,
+            min_samples_split=min_samples_split,
+            min_samples_leaf=min_samples_leaf,
+            l1_strength=l1_strength,
+            random_state=random_state,
+            debug_trace=debug_trace,
+            debug_max_nodes=debug_max_nodes,
+            weighted_bootstrap=weighted_bootstrap,
+            bootstrap_weight_mode=bootstrap_weight_mode,
+            bootstrap_temperature=bootstrap_temperature,
+            n_tries=n_tries,
+        )
+
