+            self._debug_node_counter += 1
+        else:
+            print(f"    Building node at depth {depth}, samples: {len(y)}, gini: {node['gini']:.4f}")
+        
+        # Check stopping criteria
+        # Note: max_depth=None means unlimited depth, so only check if it's set
+        if ((self.max_depth is not None and depth >= self.max_depth) or 
+            len(y) < self.min_samples_split or 
+            len(np.unique(y)) <= 1 or
+            node['gini'] < 1e-10):
+            node['is_leaf'] = True
+            print(f"    -> Leaf node (depth={depth}, samples={len(y)})")
+            return node
+        
+        # Find best oblique split using logistic regression with CART-style threshold optimization
+        w, threshold, gini = self._find_best_split_logistic(X, y, rng, node_weights_raw=node_weights_raw, node_weights_norm=node_weights_norm)
+        
+        if w is None:  # No valid split found
+            node['is_leaf'] = True
+            print(f"    -> Leaf node (no valid split found)")
+            return node
+        
+        # Apply split and create child nodes
+        z = X @ w
+        left_mask = z <= threshold  # Use <= for consistency
+        right_mask = ~left_mask
+        
+        # Ensure both children have minimum samples
+        if (np.sum(left_mask) < self.min_samples_leaf or 
+            np.sum(right_mask) < self.min_samples_leaf):
+            node['is_leaf'] = True
+            print(f"    -> Leaf node (insufficient samples in children)")
+            return node
+        
+        # Store split information and recursively build children
+        node['is_leaf'] = False
+        node['projection'] = w
+        node['threshold'] = threshold
+        
+        if should_debug:
+            print(f"    [DEBUG] Split chosen: threshold={threshold:.4f}, gini_after={gini:.4f}")
+            gini_improvement = node['gini'] - gini
+            print(f"    [DEBUG] Gini improvement: {gini_improvement:.4f}")
+        
+        print(f"    -> Split node: {np.sum(left_mask)} left, {np.sum(right_mask)} right")
+        
+        node['left'] = self._build_tree(X[left_mask], y[left_mask], depth + 1, rng)
+        node['right'] = self._build_tree(X[right_mask], y[right_mask], depth + 1, rng)
+        
+        return node
+    
+    def fit(self, X, y):
+        """
+        Train the oblique decision tree using L1-regularized logistic regression splits.
+        
+        Args:
+            X: Training feature matrix
+            y: Training target labels
+            
+        Returns:
+            self
+        """
+        print(f"  Training oblique tree with L1 strength: {self.l1_strength}")
+        
+        # Set number of classes dynamically
+        self.n_classes_ = len(np.unique(y))
+        print(f"  Detected {self.n_classes_} classes")
+        
+        # Reset debug node counter
+        self._debug_node_counter = 0
+        
+        rng = np.random.RandomState(self.random_state)
+        self.tree = self._build_tree(X, y, 0, rng)
+        return self
+    
+    def _predict_sample(self, x, node):
+        """
+        Predict class for a single sample by traversing the tree.
+        
+        Args:
+            x: Single sample feature vector
+            node: Current tree node
+            
+        Returns:
+            Predicted class label
+        """
+        if node['is_leaf']:
+            return node['predicted_class']
+        
+        # Apply learned oblique projection and threshold: w^T x <= c (consistent with training)
+        z = x @ node['projection']
+        
+        if z <= node['threshold']:
+            return self._predict_sample(x, node['left'])
+        else:
+            return self._predict_sample(x, node['right'])
+    
+    def predict(self, X):
+        """
+        Predict classes for multiple samples.
+        
+        Args:
+            X: Feature matrix for prediction
+            
+        Returns:
+            Array of predicted class labels
+        """
+        if self.tree is None:
+            raise ValueError("Tree not fitted. Call fit() first.")
+        
+        return np.array([self._predict_sample(x, self.tree) for x in X])
+    
+    def _predict_proba_sample(self, x, node):
+        """
+        Predict class probabilities for a single sample by traversing the tree.
+        
+        Args:
+            x: Single sample feature vector
+            node: Current tree node
+            
+        Returns:
+            Array of class probabilities
+        """
+        if node['is_leaf']:
+            # Return normalized class probabilities from leaf node. Prefer the
+            # explicit weighted probabilities so terminal predictions remain
+            # consistent with weighted training.
+            n_classes = self.n_classes_ if self.n_classes_ is not None else len(node['class_counts'])
+            if 'class_probabilities' in node:
+                probs = np.asarray(node['class_probabilities'], dtype=float)
+                if probs.sum() > 0:
+                    return probs / probs.sum()
+
+            total_samples = np.sum(node['class_counts'])
+            if total_samples == 0:
+                return np.ones(n_classes) / n_classes  # Uniform distribution if no samples
+            return node['class_counts'] / total_samples
+        
+        # Apply learned oblique projection and threshold: w^T x <= c (consistent with training)
+        z = x @ node['projection']
+        
+        if z <= node['threshold']:
+            return self._predict_proba_sample(x, node['left'])
+        else:
+            return self._predict_proba_sample(x, node['right'])
+    
+    def predict_proba(self, X):
+        """
+        Predict class probabilities for multiple samples.
+        
+        Args:
+            X: Feature matrix for prediction
+            
+        Returns:
+            Array of shape (n_samples, n_classes) with class probabilities
+        """
+        if self.tree is None:
+            raise ValueError("Tree not fitted. Call fit() first.")
+        
+        return np.array([self._predict_proba_sample(x, self.tree) for x in X])
+
+
+class ObliqueRandomForestMulti:
+    """
+    Bootstrap and Weighted Oblique Random Forest for multiclass classification.
+    
+    Ensemble of oblique decision trees using bootstrap sampling, L1-regularized splits, and majority voting.
+    """
+    
+    def __init__(self, n_estimators=100, max_depth=5, min_samples_split=10, 
+                 min_samples_leaf=5, l1_strength=1.0, random_state=None,
+                 debug_trace=False, debug_max_nodes=3,
+                 weighted_bootstrap=True, bootstrap_weight_mode="balanced", 
+                 bootstrap_temperature=1.0, n_tries=10):
+        """
+        Initialize bootstrap and weighted oblique random forest.
+        
+        Args:
+            n_estimators: Number of trees in the forest
+            max_depth: Maximum depth of each tree
+            min_samples_split: Minimum samples required to split
+            min_samples_leaf: Minimum samples in leaf nodes
+            l1_strength: L1 regularization strength for oblique splits
+            random_state: Random seed for reproducibility
+            debug_trace: Enable debug trace mode (only for first tree)
+            debug_max_nodes: Maximum number of nodes to trace in debug mode
+            weighted_bootstrap: If True, use non-uniform bootstrap sampling based on class weights
+            bootstrap_weight_mode: Mode for computing bootstrap weights ("balanced" for now)
+            bootstrap_temperature: Temperature for sharpening/flattening bootstrap probabilities
+            n_tries: Number of random binary split attempts per node (default=10)
+        """
+        self.n_estimators = n_estimators
+        self.max_depth = max_depth
+        self.min_samples_split = min_samples_split
+        self.min_samples_leaf = min_samples_leaf
+        self.l1_strength = l1_strength
+        self.random_state = random_state
+        self.debug_trace = debug_trace
+        self.debug_max_nodes = debug_max_nodes
+        self.weighted_bootstrap = weighted_bootstrap
+        self.bootstrap_weight_mode = bootstrap_weight_mode
+        self.bootstrap_temperature = bootstrap_temperature
+        self.n_tries = n_tries
+        self.trees = []
+    
+    def fit(self, X, y):
+        """
+        Train the bootstrap and weighted oblique random forest.
+        
+        Args:
+            X: Training feature matrix
+            y: Training target labels
+            
+        Returns:
+            self
+        """
+        rng = np.random.RandomState(self.random_state)
+        self.trees = []
+        
+        n_samples = len(X)
+        
+        print(f"Training {self.n_estimators} oblique trees with L1 regularization...")
+        print(f"  weighted_bootstrap={self.weighted_bootstrap}, bootstrap_weight_mode={self.bootstrap_weight_mode}, bootstrap_temperature={self.bootstrap_temperature}")
+        print(f"  n_tries={self.n_tries}")
+        
+        # Compute bootstrap sampling probabilities if weighted_bootstrap is enabled
+        bootstrap_probs = None
+        if self.weighted_bootstrap:
+            if self.bootstrap_weight_mode == "balanced":
+                # Compute per-sample class-balanced weights
+                unique_classes, class_counts = np.unique(y, return_counts=True)
+                n_classes = len(unique_classes)
+                
+                # Create class weight dictionary
+                class_weights_dict = {}
+                for cls, count in zip(unique_classes, class_counts):
+                    class_weights_dict[cls] = n_samples / (n_classes * count)
+                
+                # Assign weights to each sample
+                sample_weights = np.array([class_weights_dict[label] for label in y])
+                
+                # Apply temperature and normalize to probabilities
+                sample_weights_temp = sample_weights ** self.bootstrap_temperature
+                bootstrap_probs = sample_weights_temp / sample_weights_temp.sum()
+                
+                # Debug trace for weighted bootstrap
+                if self.debug_trace:
+                    print(f"\n[DEBUG WEIGHTED BOOTSTRAP]")
+                    print(f"  Mode: {self.bootstrap_weight_mode}, Temperature: {self.bootstrap_temperature}")
+                    print(f"  Class counts: {dict(zip(unique_classes, class_counts))}")
+                    print(f"  Bootstrap probabilities: sum={bootstrap_probs.sum():.6f}, min={bootstrap_probs.min():.6f}, max={bootstrap_probs.max():.6f}, mean={bootstrap_probs.mean():.6f}")
+                    for cls in unique_classes:
+                        mask = (y == cls)
+                        print(f"    Class {cls}: mean_prob={bootstrap_probs[mask].mean():.6f}, sum_prob={bootstrap_probs[mask].sum():.6f}")
+        
+        for i in range(self.n_estimators):
+            print(f"\nTraining tree {i+1}/{self.n_estimators}")
+            
+            # Bootstrap sampling with replacement
+            if self.weighted_bootstrap and bootstrap_probs is not None:
+                # Non-uniform weighted bootstrap
+                bootstrap_indices = rng.choice(n_samples, size=n_samples, replace=True, p=bootstrap_probs)
+            else:
+                # Standard uniform bootstrap
+                bootstrap_indices = rng.choice(n_samples, size=n_samples, replace=True)
+            
+            X_bootstrap = X[bootstrap_indices]
+            y_bootstrap = y[bootstrap_indices]
+            
+            # Enable debug trace only for the first tree
+            enable_debug = (i == 0) and self.debug_trace
+            
+            # Train individual oblique tree with L1-regularized splits
+            tree = ObliqueDecisionTreeMulti(
+                max_depth=self.max_depth,
+                min_samples_split=self.min_samples_split,
+                min_samples_leaf=self.min_samples_leaf,
+                l1_strength=self.l1_strength,
+                random_state=rng.randint(0, 100000),
+                debug_trace=enable_debug,
+                debug_max_nodes=self.debug_max_nodes,
+                n_tries=self.n_tries
+            )
+            
+            tree.fit(X_bootstrap, y_bootstrap)
+            self.trees.append(tree)
+            
+            # Progress indicator
+            if (i + 1) % 5 == 0:
+                print(f"  Completed {i + 1}/{self.n_estimators} trees")
+        
+        return self
+    
+    def predict(self, X):
+        """
+        Predict using majority vote from all trees.
+        
+        Args:
+            X: Feature matrix for prediction
+            
+        Returns:
+            Array of predicted class labels
+        """
+        if not self.trees:
+            raise ValueError("Forest not fitted. Call fit() first.")
+        
+        # Get predictions from all trees
+        all_predictions = np.array([tree.predict(X) for tree in self.trees])
+        
+        # Majority vote for each sample
+        predictions = []
+        for i in range(X.shape[0]):
+            tree_votes = all_predictions[:, i]
+            vote_counts = Counter(tree_votes)
+            # Get the most common prediction
+            majority_class = vote_counts.most_common(1)[0][0]
+            predictions.append(majority_class)
+        
+        return np.array(predictions)
+    
+    def predict_proba(self, X):
+        """
+        Predict class probabilities using average of all trees.
+        
+        Args:
+            X: Feature matrix for prediction
+            
+        Returns:
+            Array of shape (n_samples, n_classes) with class probabilities
+        """
+        if not self.trees:
+            raise ValueError("Forest not fitted. Call fit() first.")
+        
+        # Get probability predictions from all trees and average them
+        all_probas = np.array([tree.predict_proba(X) for tree in self.trees])
+        return np.mean(all_probas, axis=0)
+    
+    def get_feature_importance(self, X, y, n_repeats=10):
+        """
+        Calculate feature importance using permutation importance.
+        
+        Args:
+            X: Feature matrix
+            y: Target labels
+            n_repeats: Number of permutation repeats for averaging
+            
+        Returns:
+            feature_importance: Array of importance scores for each feature
+        """
+        if not self.trees:
+            raise ValueError("Forest not fitted. Call fit() first.")
+        
+        print("Calculating feature importance using permutation method...")
+        
+        # Get baseline accuracy
+        baseline_acc = accuracy_score(y, self.predict(X))
+        
+        n_features = X.shape[1]
+        importances = np.zeros(n_features)
+        
+        # Calculate permutation importance for each feature
+        for feature_idx in range(n_features):
+            feature_scores = []
+            
+            for repeat in range(n_repeats):
+                # Create a copy of X and permute the feature
+                X_permuted = X.copy()
+                
+                # Set random seed for reproducible permutation
+                rng = np.random.RandomState(self.random_state + repeat if self.random_state else None)
+                X_permuted[:, feature_idx] = rng.permutation(X_permuted[:, feature_idx])
+                
+                # Calculate accuracy with permuted feature
+                permuted_acc = accuracy_score(y, self.predict(X_permuted))
+                
+                # Importance is the decrease in accuracy
+                feature_scores.append(baseline_acc - permuted_acc)
+            
+            # Average importance across repeats
+            importances[feature_idx] = np.mean(feature_scores)
+            
+            print(f"Feature {feature_idx}: {importances[feature_idx]:.4f}")
+        
+        return importances
+    
+    def visualize_feature_importance(self, X, y, feature_names=None, n_repeats=10, save_plot=False):
+        """
+        Calculate and visualize feature importance.
+        
+        Args:
+            X: Feature matrix
+            y: Target labels
+            feature_names: Optional list of feature names
+            n_repeats: Number of permutation repeats
+            save_plot: Whether to save the plot as PNG
+            
+        Returns:
+            feature_importance: Array of importance scores
+        """
+        # Calculate feature importance
+        importance = self.get_feature_importance(X, y, n_repeats)
+        
+        # Create feature names if not provided
+        if feature_names is None:
+            feature_names = [f'Feature {i}' for i in range(len(importance))]
+        
+        # Sort features by importance
+        sorted_indices = np.argsort(importance)[::-1]
+        sorted_importance = importance[sorted_indices]
+        sorted_names = [feature_names[i] for i in sorted_indices]
+        
+        # Create visualization
+        plt.figure(figsize=(10, 6))
+        bars = plt.bar(range(len(sorted_importance)), sorted_importance, color='steelblue', alpha=0.7)
+        plt.xlabel('Features')
+        plt.ylabel('Permutation Importance (Accuracy Decrease)')
+        plt.title('Feature Importance - Bootstrap Weighted Oblique Random Forest')
+        plt.xticks(range(len(sorted_names)), sorted_names, rotation=45, ha='right')
+        plt.grid(axis='y', alpha=0.3)
+        
+        # Add value labels on bars
+        for bar, importance_val in zip(bars, sorted_importance):
+            height = bar.get_height()
+            plt.text(bar.get_x() + bar.get_width()/2., height + max(sorted_importance)*0.01,
+                    f'{importance_val:.3f}', ha='center', va='bottom', fontsize=9)
+        
+        plt.tight_layout()
+        
+        if save_plot:
+            plt.savefig('bworf_feature_importance.png', dpi=300, bbox_inches='tight')
+            print("Feature importance plot saved as 'bworf_feature_importance.png'")
+        else:
+            plt.show()
+        
+        return importance
+
