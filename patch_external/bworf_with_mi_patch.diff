+def apply_mutual_information_filtering(X_train, X_test, y_train, top_k_features=None, plot_mi=True):
+    """
+    Apply mutual information-based feature filtering.
+    
+    Args:
+        X_train: Training feature matrix
+        X_test: Test feature matrix
+        y_train: Training target labels
+        top_k_features: Number of top features to keep (if None, uses global top_k)
+        plot_mi: Whether to plot the top 20 MI features
+        
+    Returns:
+        X_train_filtered: Filtered training features
+        X_test_filtered: Filtered test features
+        selected_feature_indices: Indices of selected features
+        mi_scores: Mutual information scores for all features
+    """
+    if top_k_features is None:
+        top_k_features = top_k
+    
+    print(f"\nApplying Mutual Information-based feature filtering...")
+    print(f"Original number of features: {X_train.shape[1]}")
+    print(f"Target number of features: {top_k_features}")
+    
+    # Handle NaN values by imputing with median for numerical features
+    from sklearn.impute import SimpleImputer
+    print("Checking for and handling missing values...")
+    
+    # Check if there are any NaN values
+    if np.any(np.isnan(X_train)):
+        print("  Found NaN values, applying median imputation...")
+        # Use median imputation for numerical features
+        imputer = SimpleImputer(strategy='median')
+        X_train_imputed = imputer.fit_transform(X_train)
+        X_test_imputed = imputer.transform(X_test)
+        
+        print(f"  Imputed {np.sum(np.isnan(X_train))} NaN values in training data")
+        print(f"  Imputed {np.sum(np.isnan(X_test))} NaN values in test data")
+    else:
+        print("  No NaN values found")
+        X_train_imputed = X_train
+        X_test_imputed = X_test
+
+    # Allow MI filtering to be relaxed without rewriting the workflow.
+    if top_k_features is None or top_k_features <= 0 or top_k_features >= X_train_imputed.shape[1]:
+        print("MI filtering relaxed/bypassed; returning all features unchanged.")
+        selected_feature_indices = np.arange(X_train_imputed.shape[1])
+        return X_train_imputed, X_test_imputed, selected_feature_indices, None
+    
+    # Compute mutual information between each feature and the target y_train
+    print("Computing mutual information scores...")
+    mi_scores = mutual_info_classif(X_train_imputed, y_train, random_state=42)
+    
+    # Rank features by MI score
+    feature_rankings = np.argsort(mi_scores)[::-1]  # Descending order
+    
+    # Keep the top K features
+    selected_feature_indices = feature_rankings[:top_k_features]
+    
+    # Apply filtering to both X_train and X_test (using imputed data)
+    X_train_filtered = X_train_imputed[:, selected_feature_indices]
+    X_test_filtered = X_test_imputed[:, selected_feature_indices]
+    
+    print(f"Selected {len(selected_feature_indices)} features based on MI scores")
+    
+    # Optionally print the top 20 feature scores
+    print(f"\nTop 20 features by Mutual Information score:")
+    for i in range(min(20, len(mi_scores))):
+        feature_idx = feature_rankings[i]
+        print(f"  {i+1:2d}. Feature {feature_idx:2d}: MI = {mi_scores[feature_idx]:.4f}")
+    
+    # Optionally plot the top 20 MI features using matplotlib
+    if plot_mi:
+        plot_mutual_information_scores(mi_scores, feature_rankings, top_features=20)
+    
+    return X_train_filtered, X_test_filtered, selected_feature_indices, mi_scores
+
