+def evaluate_and_visualize(y_test, y_pred_bworf, y_pred_rf, y_proba_bworf, y_proba_rf, acc_bworf, acc_rf, f1_bworf, f1_rf):
+    """
+    Generate confusion matrices, ROC curves, and performance visualization.
+    
+    Args:
+        y_test: True test labels
+        y_pred_bworf: BWORF predictions
+        y_pred_rf: Standard RF predictions
+        y_proba_bworf: BWORF class probabilities
