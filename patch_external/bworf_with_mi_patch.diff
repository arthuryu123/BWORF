+def test_l1_strength_robustness():
+    """
+    Unit test to verify BWORF handles l1_strength=0 and l1_strength>0 correctly.
+    
+    Tests:
+    1. l1_strength=0 doesn't crash (uses large C fallback)
+    2. l1_strength>0 works normally
+    3. predict_proba returns shape (n, 2) for binary
+    4. Probabilities sum to ~1
+    """
+    print("=" * 60)
+    print("TEST: L1 Strength Robustness")
+    print("=" * 60)
+    
+    # Generate simple binary test data
+    np.random.seed(42)
+    n_samples, n_features = 100, 10
+    X = np.random.randn(n_samples, n_features)
+    y = (X[:, 0] + X[:, 1] > 0).astype(int)  # Simple linear boundary
+    
+    test_cases = [
+        {"l1_strength": 0.0, "expected": "fallback to large C"},
+        {"l1_strength": -1.0, "expected": "fallback to large C"},
+        {"l1_strength": None, "expected": "fallback to large C"},
+        {"l1_strength": 1.0, "expected": "normal operation"},
+        {"l1_strength": 0.1, "expected": "normal operation"},
+    ]
+    
+    all_passed = True
+    
+    for i, tc in enumerate(test_cases):
+        l1_val = tc["l1_strength"]
+        print(f"\n[Test {i+1}] l1_strength={l1_val} ({tc['expected']})")
+        
+        try:
+            # Create and fit model
+            model = ObliqueRandomForestMulti(
+                n_estimators=5,  # Small for speed
+                max_depth=3,
+                min_samples_split=5,
+                min_samples_leaf=2,
+                l1_strength=l1_val,
+                random_state=42
+            )
+            model.fit(X, y)
+            
+            # Check predict_proba
+            proba = model.predict_proba(X)
+            
+            # Validate shape
+            if proba.shape != (n_samples, 2):
+                print(f"  FAIL: predict_proba shape {proba.shape}, expected ({n_samples}, 2)")
+                all_passed = False
+                continue
+            
+            # Validate probabilities sum to 1
+            row_sums = proba.sum(axis=1)
+            if not np.allclose(row_sums, 1.0, atol=1e-6):
+                print(f"  FAIL: Row sums not ~1.0, range [{row_sums.min():.4f}, {row_sums.max():.4f}]")
+                all_passed = False
+                continue
+            
+            # Validate values in [0, 1]
+            if not (np.all(proba >= 0) and np.all(proba <= 1)):
+                print(f"  FAIL: Probabilities outside [0,1]")
+                all_passed = False
+                continue
+            
+            print(f"  PASS: shape={proba.shape}, row_sums in [{row_sums.min():.4f}, {row_sums.max():.4f}]")
+            
+        except Exception as e:
+            print(f"  FAIL: Exception raised: {e}")
+            all_passed = False
+    
+    print("\n" + "=" * 60)
+    if all_passed:
+        print("ALL TESTS PASSED")
+    else:
+        print("SOME TESTS FAILED")
+    print("=" * 60)
+    
+    return all_passed
+
